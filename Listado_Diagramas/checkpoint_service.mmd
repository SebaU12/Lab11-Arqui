EXEC["EXECUTION SERVICE - Genera progreso - Solicita checkpoints - Restaura ejecuciones"]

ORQ["EVALUATION ORCHESTRATOR - Estados de evaluacion - Intentos autorizados - Coordina recuperacion"]

SCHED["EVALUATION SCHEDULER - Reasigna trabajos - Solicita contexto recuperable"]

CAP["SPOT CAPACITY SERVICE - Reporta interrupciones - Identifica workers afectados"]

CHECK["CHECKPOINT SERVICE - Recibe checkpoints - Valida vigencia - Guarda progreso - Registra metadatos - Recupera ultima etapa valida - Verifica compatibilidad"]

STORE[("CHECKPOINT STORAGE - Archivos persistentes - Estados por etapa - Artefactos de progreso - Datos recuperables")]

DB[("CHECKPOINT METADATA STORE - Evaluation ID - Attempt ID - Stage - Version - Checksum - Ubicacion - Estado de persistencia")]

EVIDENCE["EXECUTION EVIDENCE STORE - Resultados por etapa - Pruebas completadas - Evidencias parciales"]

ACT["ACTIVITY SERVICE - Configuracion versionada - Tipo de evaluacion - Reglas de ejecucion"]

OBS["OBSERVABILITY SERVICE - Guardados - Recuperaciones - Fallos - Tiempo de persistencia"]

