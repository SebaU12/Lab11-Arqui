AUTH -->|Profesor autorizado| COURSE

COURSE -->|Profesor vinculado al curso| SESSION
COURSE -->|Curso no autorizado| FORBIDDEN

SESSION --> CHATDB
CHATDB --> CREATED

CHAT -->|Mensaje docente| CONTEXT
CONTEXT --> CHATDB
CONTEXT --> LIMITS

LIMITS -->|Contexto excedido| LIMIT
LIMITS -->|Contexto valido| REQUEST

REQUEST --> TOKEN
TOKEN -->|Presupuesto rechazado| LIMIT
TOKEN -->|Presupuesto reservado| LLMA

LLMA -->|Solicitud con skill autorizado| LLM
LLM -->|Respuesta estructurada| LLMA
LLM -->|Proveedor no disponible| UNAVAILABLE

LLMA -->|Consumo reportado| TOKEN
LLMA -->|Respuesta del modelo| PARSE

PARSE --> SCHEMA
SCHEMA -->|Formato invalido| BAD
SCHEMA -->|Formato valido| SAVE

SAVE --> CHATDB
CHATDB --> PROPOSED

CHAT -->|Consulta de sesion| READ
READ --> CHATDB
CHATDB --> OK

