SCHED["EVALUATION SCHEDULER - Asigna trabajos CPU y GPU - Selecciona worker compatible"]

ORQ["EVALUATION ORCHESTRATOR - Autoriza intentos - Controla vigencia - Gestiona estados y resultados"]

EXEC["EXECUTION SERVICE - Prepara sandboxes - Ejecuta evaluaciones - Aplica limites de recursos - Genera resultados tecnicos - Reporta progreso"]

CAP["SPOT CAPACITY SERVICE - Instancias CPU GPU - Recursos disponibles - Estado de workers"]

ACT["ACTIVITY SERVICE - Rubricas versionadas - Configuracion de evaluacion"]

SUB["SUBMISSION SERVICE - Commit SHA - Repositorio - Version de entrega"]

CHECK["CHECKPOINT SERVICE - Guarda progreso - Recupera etapas - Mantiene checkpoints durables"]

TOKEN["TOKEN BUDGET SERVICE - Autoriza consumo LLM - Reserva presupuesto"]

LLMA["LLM ACCESS SERVICE - Acceso autorizado al modelo - Registra consumo"]

GH["GITHUB - Repositorios - Codigo - Archivos del commit"]

IMG["IMAGE REGISTRY - Imagen base de cada curso - Version de imagen - Artefactos de 3 a 5 GB"]

AWS["AWS SPOT WORKER - Capacidad CPU o GPU - Aloja entorno de ejecucion"]

SANDBOX["MICROVM SANDBOX - Ejecuta codigo no confiable - Aislamiento individual - Recursos limitados"]

OBS["OBSERVABILITY SERVICE - Duracion - CPU GPU memoria - Fallos - Excesos de recursos"]

EVIDENCE[("EXECUTION EVIDENCE STORE - Resultados por criterio - Logs de pruebas - Errores - Referencias de artefactos")]

