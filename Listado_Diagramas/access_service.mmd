VERIFY[VALIDAR IDENTIDAD]
ROLE[RESOLVER ROL EFECTIVO]
PERM[OBTENER PERMISOS]
SCOPE[VALIDAR VINCULACION CON CURSO]
CHECK[VALIDAR ACCION Y RECURSO]
ENDSESSION[CERRAR SESION]

LOGINOK[200 AUTHENTICATED]
LOGOUTOK[200 SESSION CLOSED]
ALLOW[200 AUTHORIZED]
DENY[403 FORBIDDEN]
UNAUTH[401 UNAUTHORIZED]

PROF --> GW
EST --> GW

GW --> R1
GW --> R2
GW --> R3
GW --> R4
GW --> R5

R1 --> AUTH
R2 --> AUTH
R3 --> AUTH
R4 --> AUTH
R5 --> AUTH

AUTH -->|Login o verificacion requerida| VERIFY
VERIFY --> IDP

IDP -->|Identidad invalida| UNAUTH
IDP -->|Identidad valida| ROLE

ROLE --> AUTHDB
AUTHDB --> PERM

PERM --> COURSE
COURSE -->|Cursos y vinculaciones autorizadas| SCOPE

SCOPE --> CHECK

CHECK -->|Accion permitida| ALLOW
CHECK -->|Accion prohibida| DENY
CHECK -->|Identidad no autenticada| UNAUTH

ROLE -->|Inicio de sesion valido| LOGINOK

AUTH -->|Solicitud de cierre| ENDSESSION
ENDSESSION --> LOGOUTOK

LOGINOK --> GW
LOGOUTOK --> GW
ALLOW --> GW
DENY --> GW
UNAUTH --> GW

