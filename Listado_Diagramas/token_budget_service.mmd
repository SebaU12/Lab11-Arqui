EXEC["EXECUTION SERVICE - Solicita presupuesto para evaluaciones asistidas por LLM"]

LLMA["LLM ACCESS SERVICE - Verifica reservas - Ejecuta llamadas autorizadas - Reporta consumo real"]

ORQ["EVALUATION ORCHESTRATOR - Identifica evaluacion logica - Controla intentos y recuperaciones"]

AUTH["ACCESS SERVICE - Identidad - Roles - Permisos de consumo"]

TOKEN["TOKEN BUDGET SERVICE - Valida limites - Reserva tokens atomicamente - Controla cuotas - Concilia consumo real - Mantiene saldos - Conserva presupuesto entre intentos"]

POLICY[("TOKEN POLICY STORE - Limites por llamada - Limites por profesor - Limites por evaluacion - Limites diarios - Concurrencia permitida")]

DB[("TOKEN BUDGET STORE - Presupuesto autorizado - Tokens reservados - Tokens consumidos - Saldo disponible - Identificadores de evaluacion")]

LEDGER[("TOKEN RESERVATION LEDGER - Reservation ID - Request ID - Estado de reserva - Uso reportado - Operaciones conciliadas")]

OBS["OBSERVABILITY SERVICE - Consumo por usuario - Consumo por actividad - Consumo por evaluacion - Reservas pendientes"]

